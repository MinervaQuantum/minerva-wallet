{
  "expo": {
    "name": "Minerva Wallet",
    "slug": "minerva-wallet",
    "version": "0.2.1",
    "orientation": "portrait",
    "scheme": "minerva",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#06071a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "build.minerva.wallet",
      "buildNumber": "3"
    },
    "android": {
      "package": "build.minerva.wallet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06071a"
      },
      "versionCode": 5
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Minerva Wallet to unlock your account keys with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Minerva Wallet: post-quantum (ML-DSA-65) smart accounts on the Minerva network, with device keys and recovery."
  }
}
