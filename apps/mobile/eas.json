{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_MINERVA_DEBUG": "1"
      }
    },
    "testnet-beta": {
      "distribution": "internal",
      "channel": "testnet-beta",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_MINERVA_DEBUG": "0",
        "EXPO_PUBLIC_MINERVA_CHAIN_ID": "77138",
        "EXPO_PUBLIC_MINERVA_RPC_URL": "https://testnet.minervachain.org/rpc",
        "EXPO_PUBLIC_MINERVA_FAUCET_URL": "https://testnet.minervachain.org",
        "EXPO_PUBLIC_MINERVA_PQ_RELAYER_URL": "https://testnet.minervachain.org",
        "EXPO_PUBLIC_MINERVA_WALLET_VERSION": "0.1.1",
        "EXPO_PUBLIC_MINERVA_REQUIRE_BIOMETRIC": "1"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_MINERVA_DEBUG": "0",
        "EXPO_PUBLIC_MINERVA_CHAIN_ID": "77138",
        "EXPO_PUBLIC_MINERVA_RPC_URL": "https://testnet.minervachain.org/rpc",
        "EXPO_PUBLIC_MINERVA_FAUCET_URL": "https://testnet.minervachain.org",
        "EXPO_PUBLIC_MINERVA_PQ_RELAYER_URL": "https://testnet.minervachain.org",
        "EXPO_PUBLIC_MINERVA_WALLET_VERSION": "0.1.1",
        "EXPO_PUBLIC_MINERVA_REQUIRE_BIOMETRIC": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
