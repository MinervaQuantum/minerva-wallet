# Set to 1 only for local debug-only inspectors.
#
# Keep 0 for shareable / production builds.
EXPO_PUBLIC_MINERVA_DEBUG=0

# Set to 1 in native release builds to require device authentication before
# reading or updating the on-device ML-DSA profile.
EXPO_PUBLIC_MINERVA_REQUIRE_BIOMETRIC=0

# Default: live Minerva Testnet (the product default network).
EXPO_PUBLIC_MINERVA_RPC_URL=https://testnet.minervachain.org/rpc
EXPO_PUBLIC_MINERVA_FAUCET_URL=https://testnet.minervachain.org
EXPO_PUBLIC_MINERVA_PQ_RELAYER_URL=https://testnet.minervachain.org
# No public Minerva testnet indexer yet; leave unset.
# EXPO_PUBLIC_MINERVA_INDEXER_URL=
EXPO_PUBLIC_MINERVA_WALLET_VERSION=0.0.27

# Local Minerva devnet alternative.
# Start a local Minerva Network devnet first, for example from a sibling MinervaNetwork checkout:
# pnpm coregeth:build && pnpm devnet:start && pnpm contracts:deploy:devnet
# EXPO_PUBLIC_MINERVA_CHAIN_ID=77137
# EXPO_PUBLIC_MINERVA_RPC_URL=http://127.0.0.1:18545/rpc
# EXPO_PUBLIC_MINERVA_FAUCET_URL=http://127.0.0.1:18546
# EXPO_PUBLIC_MINERVA_PQ_RELAYER_URL=http://127.0.0.1:18548
# EXPO_PUBLIC_MINERVA_INDEXER_URL=http://127.0.0.1:18549

# Supported chain IDs: 77137 (Minerva Devnet), 77138 (Minerva Testnet).
EXPO_PUBLIC_MINERVA_CHAIN_ID=77138

# Optional account address override for live balance/deployment reads.
# Leave empty to use the wallet-owned encrypted ML-DSA profile.
EXPO_PUBLIC_MINERVA_ACCOUNT_ADDRESS=

# WalletConnect v2 (Reown WalletKit). Leave empty to disable the feature in the build.
# EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
