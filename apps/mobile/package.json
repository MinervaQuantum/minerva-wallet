    "@babel/core": "^7.29.7",
    "@types/react": "~18.3.31",
    "babel-preset-expo": "~12.0.12",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~8.0.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
