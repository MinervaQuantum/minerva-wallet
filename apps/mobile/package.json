{
  "name": "@minerva/mobile",
  "version": "0.2.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "build:web": "expo export --platform web",
    "devnet:acceptance": "NODE_OPTIONS=--conditions=import tsx scripts/devnet-acceptance.ts",
    "devnet:rotate-acceptance": "NODE_OPTIONS=--conditions=import tsx scripts/devnet-rotation-acceptance.ts",
    "devnet:device-acceptance": "NODE_OPTIONS=--conditions=import tsx scripts/devnet-device-key-acceptance.ts",
    "devnet:ui-smoke": "node scripts/devnet-ui-smoke.mjs",
    "pq-vault:generate": "NODE_OPTIONS=--conditions=import tsx scripts/pq-vault-generate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo-google-fonts/manrope": "^0.2.3",
    "@expo-google-fonts/roboto-mono": "^0.2.3",
    "@expo-google-fonts/space-grotesk": "^0.2.3",
    "@expo/metro-runtime": "4.0.1",
    "@minerva/chain-config": "link:../../../network/packages/chain-config",
    "@minerva/core": "workspace:*",
    "@minerva/evm": "workspace:*",
    "@minerva/keystore": "workspace:*",
    "@minerva/pq-crypto": "workspace:*",
    "@minerva/pq-native-tx": "link:../../../network/packages/pq-native-tx",
    "@minerva/sdk": "link:../../../network/packages/sdk",
    "@minerva/ui-tokens": "workspace:*",
    "@minerva/wallet-policy": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@reown/walletkit": "1.2.3",
    "@walletconnect/core": "2.19.2",
    "@walletconnect/react-native-compat": "2.17.3",
    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-background-fetch": "~13.0.6",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.1",
    "expo-crypto": "~14.0.2",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.5",
    "expo-local-authentication": "~15.0.2",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-task-manager": "~12.0.6",
    "fast-text-encoding": "1.0.6",
    "lucide-react-native": "^0.468.0",
    "nativewind": "^4.2.7",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-css-interop": "0.2.3",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-get-random-values": "1.11.0",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
